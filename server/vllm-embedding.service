[Unit]
Description=vLLM - BAAI/bge-m3 Embedding port 8013
After=network.target vllm-chat-vision.service

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME
ExecStartPre=/bin/bash -c 'until curl -sf http://localhost:8012/health > /dev/null 2>&1; do sleep 10; done'
ExecStart=/home/YOUR_USERNAME/venvs/vllm/bin/vllm serve BAAI/bge-m3 --host 0.0.0.0 --port 8013 --dtype bfloat16 --gpu-memory-utilization 0.05 --max-num-seqs 4
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
Environment=PATH=/home/YOUR_USERNAME/venvs/vllm/bin:/home/YOUR_USERNAME/miniforge3/bin:/usr/local/cuda-13.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=CUDA_HOME=/usr/local/cuda-13.0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
